# Coding Hub Environment Configuration
PORT=3000
NODE_ENV=development

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=codinghub

# MySQL Database Configuration (Aiven Cloud MySQL)
DB_HOST=your-mysql-host.aivencloud.com
DB_PORT=16552
DB_USER=avnadmin
DB_PASSWORD=your_password_here
DB_NAME=coding_hub
DB_DEFAULT_NAME=defaultdb
DB_SSL=true

# Optional: Judge0 CE API URL for compiling C, C++, Java, etc. (e.g. https://judge0-ce.p.rapidapi.com or self-hosted)
# JUDGE0_URL=http://localhost:2358
JUDGE0_URL=
